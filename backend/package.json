{
  "name": "coop-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:reset:accounts": "ts-node -P tsconfig.scripts.json prisma/reset-accounts-only.ts",
    "prisma:reset:deploy": "ts-node -P tsconfig.scripts.json prisma/reset-for-deploy.ts",
    "prisma:seed:catalog": "ts-node -P tsconfig.scripts.json prisma/seed-catalog-only.ts",
    "prisma:studio": "prisma studio",
    "assets:fetch": "node scripts/fetch-seed-images.mjs",
    "assets:generate": "node scripts/generate-seed-images.mjs",
    "storage:seed": "ts-node -P tsconfig.scripts.json scripts/seed-product-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.4.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
