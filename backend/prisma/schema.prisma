generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  resident
  coordinator
  employee
  admin
}

enum DriverApplicationStatus {
  draft
  pending
  approved
  rejected
}

enum DriverDocumentType {
  passport
  license
  sts
  vehicle
  selfie
}

enum RoundStatus {
  open
  closed
  fulfilled
}

enum OrderStatus {
  submitted
  confirmed
  in_transit
  at_pickup
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  held
  released
  refunded
}

enum TransportType {
  winter_road
  river
  highway
}

enum DeliveryStopStatus {
  pending
  in_progress
  completed
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum OrderItemProcurementStatus {
  pending
  purchased
  refunded
}

/// Населённый пункт (точка раздачи в посёлке).
model PickupPoint {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  address  String?
  phone    String?
  district String?
  ulus     String?

  users          User[]
  orders         Order[]
  deliveryStops  RoundDeliveryStop[]
  routeWaypoints RouteWaypoint[]
  roundWaypoints RoundWaypoint[]

  @@map("pickup_points")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  phone          String?  @unique
  hashedPassword String   @map("hashed_password")
  fullName       String?  @map("full_name")
  role           UserRole @default(resident)
  pickupPointId  String?  @map("pickup_point_id") @db.Uuid
  deliveryAddress      String?  @map("delivery_address")
  isActive             Boolean  @default(true) @map("is_active")
  mustChangePassword   Boolean  @default(false) @map("must_change_password")
  createdAt            DateTime @default(now()) @map("created_at")

  pickupPoint         PickupPoint?         @relation(fields: [pickupPointId], references: [id])
  cartItems           CartItem[]
  orders              Order[]
  roundParticipations RoundParticipant[]
  notifications       Notification[]
  driverApplications  DriverApplication[]
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  driverRoutes        Route[]             @relation("DriverRoutes")
  driverRounds        Round[]             @relation("DriverRounds")

  @@map("users")
}

model Route {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  transportType   TransportType @default(highway) @map("transport_type")
  seasonNote      String?       @map("season_note")
  isTemplate      Boolean       @default(false) @map("is_template")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid

  createdBy User?           @relation("DriverRoutes", fields: [createdByUserId], references: [id], onDelete: SetNull)
  waypoints RouteWaypoint[]

  @@map("routes")
}

model RoundWaypoint {
  id                 String  @id @default(uuid()) @db.Uuid
  roundId            String  @map("round_id") @db.Uuid
  pickupPointId      String  @map("pickup_point_id") @db.Uuid
  sortOrder          Int     @map("sort_order")
  isProcurementPoint Boolean @default(false) @map("is_procurement_point")

  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id])

  @@unique([roundId, pickupPointId])
  @@map("round_waypoints")
}

model RouteWaypoint {
  id                 String  @id @default(uuid()) @db.Uuid
  routeId            String  @map("route_id") @db.Uuid
  pickupPointId      String  @map("pickup_point_id") @db.Uuid
  sortOrder          Int     @map("sort_order")
  isProcurementPoint Boolean @default(false) @map("is_procurement_point")

  route       Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id])

  @@unique([routeId, pickupPointId])
  @@map("route_waypoints")
}

model Round {
  id                 String        @id @default(uuid()) @db.Uuid
  title              String?
  routeTitle         String?       @map("route_title")
  transportType      TransportType @default(highway) @map("transport_type")
  createdByUserId    String?       @map("created_by_user_id") @db.Uuid
  status             RoundStatus   @default(open)
  createdAt          DateTime      @default(now()) @map("created_at")
  closesAt           DateTime      @map("closes_at")
  emergencyCloseAt   DateTime?     @map("emergency_close_at")
  minParticipants    Int           @default(3) @map("min_participants")
  targetParticipants Int           @default(15) @map("target_participants")
  participantsCount  Int           @default(0) @map("participants_count")
  currentWeightKg    Decimal       @default(0) @map("current_weight_kg") @db.Decimal(10, 2)
  targetWeightKg     Decimal       @default(500) @map("target_weight_kg") @db.Decimal(10, 2)
  actualPurchaseTotal Decimal?     @map("actual_purchase_total") @db.Decimal(12, 2)
  purchaseSettledAt  DateTime?     @map("purchase_settled_at")

  createdBy      User?               @relation("DriverRounds", fields: [createdByUserId], references: [id], onDelete: SetNull)
  waypoints      RoundWaypoint[]
  cartItems      CartItem[]
  orders         Order[]
  participants   RoundParticipant[]
  deliveryStops  RoundDeliveryStop[]
  procurementReceipts RoundProcurementReceipt[]

  @@map("rounds")
}

model RoundDeliveryStop {
  id                       String             @id @default(uuid()) @db.Uuid
  roundId                  String             @map("round_id") @db.Uuid
  pickupPointId            String             @map("pickup_point_id") @db.Uuid
  status                   DeliveryStopStatus @default(pending)
  sortOrder                Int                @default(0) @map("sort_order")
  completedAt              DateTime?          @map("completed_at")
  isProcurementStop        Boolean            @default(false) @map("is_procurement_stop")
  procurementCompletedAt   DateTime?          @map("procurement_completed_at")

  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id])

  @@unique([roundId, pickupPointId], name: "uq_round_delivery_stop")
  @@map("round_delivery_stops")
}

model RoundParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  roundId  String   @map("round_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([userId, roundId], name: "uq_round_participant_user_round")
  @@map("round_participants")
}

model RoundProcurementReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  objectKey String   @map("object_key")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("round_procurement_receipts")
}

model Category {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique
  hint      String?
  sortOrder Int     @default(0) @map("sort_order")

  products Product[]

  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  name                 String
  description          String?
  unit                 String   @default("шт")
  priceEstimate        Decimal  @default(0) @map("price_estimate") @db.Decimal(12, 2)
  weightKg             Decimal  @default(1) @map("weight_kg") @db.Decimal(8, 3)
  imageUrl             String?  @map("image_url")
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  isActive             Boolean  @default(true) @map("is_active")

  category  Category   @relation(fields: [categoryId], references: [id])
  cartItems CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  round   Round   @relation(fields: [roundId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId], name: "uq_cart_user_product")
  @@map("cart_items")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  publicNumber   String      @unique @map("public_number")
  userId         String      @map("user_id") @db.Uuid
  roundId        String      @map("round_id") @db.Uuid
  pickupPointId  String?       @map("pickup_point_id") @db.Uuid
  deliveryAddress String?      @map("delivery_address")
  status         OrderStatus   @default(submitted)
  paymentStatus  PaymentStatus @default(pending) @map("payment_status")
  totalEstimate  Decimal       @default(0) @map("total_estimate") @db.Decimal(12, 2)
  refundAmount   Decimal       @default(0) @map("refund_amount") @db.Decimal(12, 2)
  customerNote   String?     @map("customer_note")
  statusNote     String?     @map("status_note")
  expectedAt     DateTime?   @map("expected_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  round       Round        @relation(fields: [roundId], references: [id])
  pickupPoint PickupPoint? @relation(fields: [pickupPointId], references: [id])
  items       OrderItem[]
  tickets     Ticket[]

  @@map("orders")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ticketId  String?  @map("ticket_id") @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid
  subject        String
  status         TicketStatus @default(open)
  unreadByAdmin  Boolean      @default(true) @map("unread_by_admin")
  unreadByUser   Boolean      @default(false) @map("unread_by_user")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  notifications Notification[]

  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket      Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]

  @@map("ticket_messages")
}

model TicketAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  url       String
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

model DriverApplication {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  status           DriverApplicationStatus @default(draft)
  vehicleSummary   String?                 @map("vehicle_summary")
  rejectionReason  String?                 @map("rejection_reason")
  submittedAt      DateTime?               @map("submitted_at")
  reviewedAt       DateTime?               @map("reviewed_at")
  createdAt        DateTime                @default(now()) @map("created_at")

  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents DriverApplicationDocument[]

  @@map("driver_applications")
}

model DriverApplicationDocument {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  type          DriverDocumentType
  objectKey     String             @map("object_key")
  fileName      String?            @map("file_name")
  mimeType      String?            @map("mime_type")
  url           String
  createdAt     DateTime           @default(now()) @map("created_at")

  application DriverApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@map("driver_application_documents")
}

model OrderItem {
  id                       String                     @id @default(uuid()) @db.Uuid
  orderId                  String                     @map("order_id") @db.Uuid
  productId                String                     @map("product_id") @db.Uuid
  productName              String                     @map("product_name")
  quantity                 Int
  unit                     String
  priceSnapshot            Decimal                    @map("price_snapshot") @db.Decimal(12, 2)
  procurementStatus        OrderItemProcurementStatus @default(pending) @map("procurement_status")
  procurementPickupPointId String?                    @map("procurement_pickup_point_id") @db.Uuid

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
