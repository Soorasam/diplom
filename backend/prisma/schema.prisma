generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  resident
  coordinator
  employee
  admin
}

enum DriverApplicationStatus {
  draft
  pending
  approved
  rejected
}

enum DriverDocumentType {
  passport
  license
  sts
  vehicle
  selfie
}

enum RoundStatus {
  open
  closed
  fulfilled
}

enum OrderStatus {
  submitted
  confirmed
  in_transit
  at_pickup
  delivered
  cancelled
}

enum TransportType {
  winter_road
  river
  highway
}

enum DeliveryStopStatus {
  pending
  in_progress
  completed
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  phone          String?  @unique
  hashedPassword String   @map("hashed_password")
  fullName       String?  @map("full_name")
  role           UserRole @default(resident)
  settlementId   String?  @map("settlement_id") @db.Uuid
  pickupPointId  String?  @map("pickup_point_id") @db.Uuid
  isActive             Boolean  @default(true) @map("is_active")
  mustChangePassword   Boolean  @default(false) @map("must_change_password")
  createdAt            DateTime @default(now()) @map("created_at")

  settlement  Settlement?  @relation(fields: [settlementId], references: [id])
  pickupPoint PickupPoint? @relation(fields: [pickupPointId], references: [id])
  cartItems           CartItem[]
  orders              Order[]
  roundParticipations RoundParticipant[]
  notifications       Notification[]
  driverApplications  DriverApplication[]

  @@map("users")
}

model Settlement {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  district String?
  ulus     String?

  pickupPoints PickupPoint[]
  users        User[]

  @@map("settlements")
}

model PickupPoint {
  id               String  @id @default(uuid()) @db.Uuid
  settlementId     String  @map("settlement_id") @db.Uuid
  coordinatorName  String  @map("coordinator_name")
  address          String?
  phone            String?

  settlement Settlement @relation(fields: [settlementId], references: [id])
  users          User[]
  orders         Order[]
  deliveryStops  RoundDeliveryStop[]

  @@map("pickup_points")
}

model Route {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  transportType TransportType @default(highway) @map("transport_type")
  seasonNote    String?       @map("season_note")

  rounds Round[]

  @@map("routes")
}

model Round {
  id                 String      @id @default(uuid()) @db.Uuid
  routeId            String      @map("route_id") @db.Uuid
  title              String?
  status             RoundStatus @default(open)
  createdAt          DateTime    @default(now()) @map("created_at")
  closesAt           DateTime    @map("closes_at")
  minParticipants    Int         @default(10) @map("min_participants")
  targetParticipants Int         @default(50) @map("target_participants")
  participantsCount  Int         @default(0) @map("participants_count")
  currentWeightKg    Decimal     @default(0) @map("current_weight_kg") @db.Decimal(10, 2)
  targetWeightKg     Decimal     @default(500) @map("target_weight_kg") @db.Decimal(10, 2)

  route        Route              @relation(fields: [routeId], references: [id])
  cartItems    CartItem[]
  orders         Order[]
  participants   RoundParticipant[]
  deliveryStops  RoundDeliveryStop[]

  @@map("rounds")
}

model RoundDeliveryStop {
  id            String             @id @default(uuid()) @db.Uuid
  roundId       String             @map("round_id") @db.Uuid
  pickupPointId String             @map("pickup_point_id") @db.Uuid
  status        DeliveryStopStatus @default(pending)
  sortOrder     Int                @default(0) @map("sort_order")
  completedAt   DateTime?          @map("completed_at")

  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id])

  @@unique([roundId, pickupPointId], name: "uq_round_delivery_stop")
  @@map("round_delivery_stops")
}

model RoundParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  roundId  String   @map("round_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([userId, roundId], name: "uq_round_participant_user_round")
  @@map("round_participants")
}

model Category {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique
  hint      String?
  sortOrder Int     @default(0) @map("sort_order")

  products Product[]

  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  name                 String
  description          String?
  unit                 String   @default("шт")
  priceEstimate        Decimal  @default(0) @map("price_estimate") @db.Decimal(12, 2)
  weightKg             Decimal  @default(1) @map("weight_kg") @db.Decimal(8, 3)
  imageUrl             String?  @map("image_url")
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  isActive             Boolean  @default(true) @map("is_active")

  category  Category   @relation(fields: [categoryId], references: [id])
  cartItems CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  round   Round   @relation(fields: [roundId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, roundId, productId], name: "uq_cart_user_round_product")
  @@map("cart_items")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  publicNumber   String      @unique @map("public_number")
  userId         String      @map("user_id") @db.Uuid
  roundId        String      @map("round_id") @db.Uuid
  pickupPointId  String?     @map("pickup_point_id") @db.Uuid
  status         OrderStatus @default(submitted)
  totalEstimate  Decimal     @default(0) @map("total_estimate") @db.Decimal(12, 2)
  statusNote     String?     @map("status_note")
  expectedAt     DateTime?   @map("expected_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  round       Round        @relation(fields: [roundId], references: [id])
  pickupPoint PickupPoint? @relation(fields: [pickupPointId], references: [id])
  items       OrderItem[]

  @@map("orders")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model DriverApplication {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  status           DriverApplicationStatus @default(draft)
  vehicleSummary   String?                 @map("vehicle_summary")
  rejectionReason  String?                 @map("rejection_reason")
  submittedAt      DateTime?               @map("submitted_at")
  reviewedAt       DateTime?               @map("reviewed_at")
  createdAt        DateTime                @default(now()) @map("created_at")

  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents DriverApplicationDocument[]

  @@map("driver_applications")
}

model DriverApplicationDocument {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  type          DriverDocumentType
  objectKey     String             @map("object_key")
  fileName      String?            @map("file_name")
  mimeType      String?            @map("mime_type")
  url           String
  createdAt     DateTime           @default(now()) @map("created_at")

  application DriverApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@map("driver_application_documents")
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  productName   String  @map("product_name")
  quantity      Int
  unit          String
  priceSnapshot Decimal @map("price_snapshot") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
