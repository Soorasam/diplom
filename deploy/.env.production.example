# Скопируйте в корень репозитория как .env.production (не коммитьте!)
# cp deploy/.env.production.example .env.production

# --- Postgres (docker-compose.prod.yml) ---
POSTGRES_USER=coop
POSTGRES_PASSWORD=ЗАМЕНИТЕ_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=coop

# --- API ---
JWT_SECRET=ЗАМЕНИТЕ_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА
JWT_ACCESS_EXPIRES=60m
JWT_REFRESH_EXPIRES=7d
PORT=3000

# Ваш домен с HTTPS (тот же хост — для картинок MinIO через nginx)
CORS_ORIGINS=https://soorasam.github.io,https://coop.example.ru

# --- MinIO ---
MINIO_ACCESS_KEY=ЗАМЕНИТЕ_MINIO_USER
MINIO_SECRET_KEY=ЗАМЕНИТЕ_MINIO_PASSWORD
MINIO_BUCKET=coop-products
MINIO_DRIVER_BUCKET=coop-driver-docs
# Публичные URL картинок (браузер). Должны открываться через nginx → minio
MINIO_PUBLIC_URL=https://coop.example.ru
